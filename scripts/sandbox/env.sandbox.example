# Sandbox credentials for the OCN Node. Copy to ../../.env (gitignored) and fill in.
# Never commit real values. See docs/sandbox-setup.md for how to obtain each one.

# Stitch test client (https://docs.stitch.money)
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=

# Ledfra sandbox ledger
LEDFRA_API_TOKEN=
LEDFRA_LEDGER_ID=

# Solana devnet wallet: path to a keypair JSON file kept outside the repo
SOLANA_DEVNET_KEYPAIR_PATH=

# EVM testnet wallet (Base Sepolia): path to a file holding the private key, kept outside the repo
EVM_TESTNET_PRIVATE_KEY_PATH=
