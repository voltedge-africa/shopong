{
  "name": "@shopong/shopong",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir web-dist",
    "bundle:native": "expo export --platform android --platform ios --output-dir native-dist",
    "check-types": "tsc --noEmit",
    "test": "vp test"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.15",
    "@shopong/events": "workspace:*",
    "@shopong/scenario-stokvel": "workspace:*",
    "expo": "58.0.19",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-linking": "58.0.14",
    "expo-router": "58.0.26",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
