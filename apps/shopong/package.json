{
  "name": "@shopong/shopong",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm --filter @shopong/miniapp-delivery build && expo start",
    "android": "pnpm --filter @shopong/miniapp-delivery build && expo start --android",
    "ios": "pnpm --filter @shopong/miniapp-delivery build && expo start --ios",
    "web": "pnpm --filter @shopong/miniapp-delivery build && expo start --web",
    "build": "pnpm --filter @shopong/miniapp-delivery build && expo export --platform web --output-dir web-dist",
    "check-types": "tsc --noEmit",
    "test": "vp test"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.15",
    "@expo/vector-icons": "15.1.1",
    "@noble/hashes": "2.4.0",
    "@openuidev/react-lang": "1.0.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@shopong/adapter-ucan-iso": "workspace:*",
    "@shopong/adapters-memory": "workspace:*",
    "@shopong/adapters-openui": "workspace:*",
    "@shopong/community": "workspace:*",
    "@shopong/events": "workspace:*",
    "@shopong/miniapp": "workspace:*",
    "@shopong/miniapp-chat": "workspace:*",
    "@shopong/miniapp-delivery": "workspace:*",
    "@shopong/miniapp-insights": "workspace:*",
    "@shopong/miniapp-orders": "workspace:*",
    "@shopong/miniapp-shop": "workspace:*",
    "@shopong/miniapp-timeline": "workspace:*",
    "@shopong/miniapp-wallet": "workspace:*",
    "@shopong/ports": "workspace:*",
    "effect": "4.0.6",
    "expo": "58.0.19",
    "expo-asset": "58.0.18",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.11",
    "expo-image-picker": "58.0.10",
    "expo-linear-gradient": "58.0.3",
    "expo-linking": "58.0.14",
    "expo-router": "58.0.26",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "expo-symbols": "58.0.4",
    "expo-web-browser": "58.0.6",
    "panelui-native": "0.114.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
