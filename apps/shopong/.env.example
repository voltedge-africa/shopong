# Copy to apps/shopong/.env for a local build. Every value here is a placeholder, not a real address.
# The address of the OCN Node this build talks to (story 3.4). It is not a secret, but it is set per build profile.
# Use HTTPS outside local development. The Android emulator reaches the host's Node at 10.0.2.2, not localhost.
# EXPO_PUBLIC_OCN_NODE_URL=https://node.example.org
# EXPO_PUBLIC_OCN_NODE_URL=http://10.0.2.2:8787
