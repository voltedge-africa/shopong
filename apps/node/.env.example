# Copy to .env (git-ignored) for local development. `pnpm --filter @shopong/node dev`
# loads .env automatically. Every value below is a placeholder, not a real credential.
# Secrets live only on the OCN Node: never put them in the config file, the Expo
# app or the web console.

# Non-secret settings (all optional; they can also come from the config file)
OCN_NODE_PORT=8787
OCN_NODE_HOST=127.0.0.1
OCN_NODE_LOG_LEVEL=info
# Production refuses a wildcard browser origin. Use "development" only on a machine you run yourself.
# OCN_NODE_ENVIRONMENT=production
# Exact origins of the web app allowed to call the Node (comma-separated). Empty means no browser origin.
# OCN_NODE_CORS_ORIGINS=https://app.example.org,http://localhost:8081
# The most communities this Node hosts, all creators together (default 50).
# OCN_NODE_MAX_COMMUNITIES=50
# DIDs allowed to create communities (comma-separated did:key identities). Empty means open: for local development only.
# OCN_NODE_ALLOWED_CREATORS=did:key:z6Mk...
# OCN_NODE_DATA_DIR=./ocn-data
# OCN_NODE_CONFIG=./ocn-node.config.example.json
# OCN_NODE_RECORD_ENABLED=true
# OCN_NODE_QUEUE_ENABLED=true
# OCN_NODE_LEDGER_ENABLED=false
# OCN_NODE_PAYMENTS_ENABLED=false

# Required while the record is enabled (on by default): 32 bytes as 64 hex characters.
# The placeholder is not valid: the Node refuses to start until you replace it with the output of
# `openssl rand -hex 32`. Keep the real key safe: it derives
# the record's keys, and losing it means losing access to the record on this Node.
RECORD_MASTER_KEY=replace-with-64-hex-characters

# Optional: the community secret for personal-data commitments (story 2.7). 32 bytes as 64 hex characters.
# Needed only for POST /commitments. The placeholder is not valid. Generate with `openssl rand -hex 32`.
# Never leave this on a phone or in the config file.
# COMMUNITY_SECRET=replace-with-64-hex-characters

# Required while payments is enabled
# STITCH_CLIENT_ID=replace-me
# STITCH_CLIENT_SECRET=replace-me

# Required while ledger is enabled
# LEDFRA_API_TOKEN=replace-me

# Optional placeholders (their components do not exist yet)
# STABLECOIN_SIGNING_KEY=replace-me
# LLM_API_KEY=replace-me

# Any secret can instead be a path to a file holding the value (Docker/Kubernetes secrets):
# LEDFRA_API_TOKEN_FILE=/run/secrets/ledfra_api_token
