    "fastify": "5.12.7",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
