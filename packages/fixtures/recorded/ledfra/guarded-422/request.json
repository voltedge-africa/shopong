{
  "method": "POST",
  "url": "https://api.ledfra.example/api/ledgers/ledger_sandbox_001/transactions",
  "headers": {
    "authorization": "Bearer <LEDFRA_API_TOKEN>",
    "content-type": "application/json",
    "idempotency-key": "<event-id: overdraw attempt>"
  },
  "body": {
    "description": "Payout to member 0001 beyond balance",
    "metadata": {
      "eventId": "<event-id: SHA-512 hex of the order event>"
    },
    "entries": [
      {
        "account": "liabilities:member/0001",
        "direction": "DEBIT",
        "amount": "ZAR:5000.00"
      },
      {
        "account": "assets:stitch-settlement",
        "direction": "CREDIT",
        "amount": "ZAR:5000.00"
      }
    ]
  }
}
