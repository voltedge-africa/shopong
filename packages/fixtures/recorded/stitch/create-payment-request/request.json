{
  "method": "POST",
  "url": "https://api.stitch.money/graphql",
  "headers": {
    "authorization": "Bearer <STITCH_ACCESS_TOKEN>",
    "content-type": "application/json"
  },
  "body": {
    "query": "mutation CreatePaymentRequest($input: ClientPaymentInitiationRequestCreateInput!) { clientPaymentInitiationRequestCreate(input: $input) { paymentInitiationRequest { id url } } }",
    "variables": {
      "input": {
        "amount": {
          "quantity": "125.50",
          "currency": "ZAR"
        },
        "payerReference": "OCN-ORDER-0001",
        "beneficiaryReference": "Shopong order 0001",
        "externalReference": "<event-id: SHA-512 hex of the order event>",
        "expireAt": "2026-10-24T16:00:00.000Z",
        "payerInformation": {
          "payerId": "<community-member-commitment>"
        },
        "paymentMethods": {
          "eft": {
            "enabled": true
          },
          "card": {
            "enabled": false
          }
        }
      }
    }
  }
}
