{
  "name": "@shopong/events",
  "version": "0.0.0",
  "private": true,
  "description": "OCN event envelope, canonical JSON (RFC 8785 profile), SHA-512 event ids and keyed commitments",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vectors/golden.json": "./vectors/golden.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "vectors": "python3 -I scripts/gen_vectors.py vectors/golden.json"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  }
}
